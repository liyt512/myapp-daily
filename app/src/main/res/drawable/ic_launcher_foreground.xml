<?xml version="1.0" encoding="utf-8"?>
<!--
  黑底白线条图标，风格类似 >,< 颜文字
  白线条圆角矩形外框 + 内部极简笑脸
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="14"
        android:translateY="14">

        <!-- 全黑底色（防止透明区域显示白边） -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M0,0 L80,0 L80,80 L0,80 Z"/>

        <!-- 外框：圆角矩形轮廓 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3"
            android:pathData="M4,4 L76,4 Q80,4 80,8 L80,72 Q80,76 76,76 L4,76 Q0,76 0,72 L0,8 Q0,4 4,4 Z"/>

        <!-- 左眼 > 的两笔 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M22,28 L32,36 L22,44"/>

        <!-- 右眼 < 的两笔 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M58,28 L48,36 L58,44"/>

        <!-- 嘴巴：萌妹式短微笑 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M28,56 Q40,66 52,56"/>

    </group>
</vector>